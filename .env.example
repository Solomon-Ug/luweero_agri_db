# ============================================================
# Environment Variables Template for Luweero Agri DB
# ============================================================
# Port to listen on (Render automatically provides this)
PORT=3000

# MongoDB Connection String:
# - Local MongoDB: mongodb://127.0.0.1:27017
# - Render / MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/luweero_agri_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database Name (default: luweero_agri_db)
DB_NAME=luweero_agri_db

# Node Environment
NODE_ENV=production

